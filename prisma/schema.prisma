generator client {
  provider = "prisma-client"
  output   = "./generated/"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  twoFactorEnabled Boolean        @default(false)
  backupCodes      String         @default("")
  loginAttempts    LoginAttempt[]
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  description String
  location    String
  skills      String
  isCurrent   Boolean   @default(false)
  imageUrl    String?
  imageAlt    String?
  startDate   DateTime
  endDate     DateTime?
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String
  userAgent String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  subject   String
  message   String
  source    String?  @default("contact form")
  createdAt DateTime @default(now())
  status    String   @default("unread")
  notes     String?
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  altText   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Project {
  id          String         @id @default(cuid())
  title       String
  description String
  tags        String
  visible     Boolean        @default(true)
  featured    Boolean        @default(false)
  link        String?
  repository  String?
  images      ProjectImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
